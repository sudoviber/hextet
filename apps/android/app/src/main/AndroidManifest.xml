<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground service (Android 9+ / API 28). The VPN tunnel runs as a foreground
         service so the system does not kill it while backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) requires a declared FGS type; VPN uses `specialUse`. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ (API 33) runtime permission for the notification drawer. The VPN
         foreground-service notification is generally shown regardless, but a full app should
         request this from an Activity (out of scope for this slice). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The WG UDP socket + DHT control plane need outbound network access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- The VpnService shell (ADR-0014 slice D). `BIND_VPN_SERVICE` restricts binding to
             the system, which is what invokes onStartCommand after `VpnService.prepare()`. -->
        <service
            android:name=".HextetVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="IPv6 mesh VPN tunnel" />
        </service>
    </application>

</manifest>
