{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hextet",
  "version": "0.1.0",
  "identifier": "dev.sudoviber.hextet",
  "build": {
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../web run build",
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "hextet", "width": 900, "height": 700 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8080; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
