// hextet engine FFI 接口定义（UniFFI UDL）。
//
// 返回类型都是 `string`（JSON）；错误约定为返回 `{"error":"..."}` JSON（Kotlin 侧判
// `error` 键区分成功/失败）。daemon_spawn 返回 `{"handle":u64}`，daemon_shutdown 返回
// `{}`（成功）。

namespace hextet {
    string load_config(string path);
    string status(string config_path);
    string daemon_spawn(string config_path);
    string daemon_shutdown(u64 handle);
};
